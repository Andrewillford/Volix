# ==========================================================================
#  LogHub - configuracao do ambiente de HOMOLOGACAO (teste)
#  Copie este arquivo como ".env" NA RAIZ da pasta de homologacao
#  (C:\LogHub-HOMOLOG\.env). O criar-ambiente-homolog.bat ja faz isso.
#  Regra de ouro: NUNCA use o token real do Olist aqui.
# ==========================================================================

# Identifica o ambiente (reservado para o aviso visual de HOMOLOGACAO)
LOGHUB_AMBIENTE=homologacao

# Olist DESLIGADO em homologacao: sem token e sem sincronizacao automatica,
# para nunca ler/escrever no Olist real durante os testes.
OLIST_TOKEN=
OLIST_AUTO=0
