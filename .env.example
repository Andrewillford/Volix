# Pasta com as tabelas Excel/CSV das transportadoras
TABLES_DIR=./tables

# Pasta base do fluxo de CTe. O botão "Escanear pasta" lê os .xml de CTE_DIR/entrada
# e, depois de auditar, move cada arquivo para CTE_DIR/processados/ok ou .../nok
# conforme o resultado (as subpastas são criadas automaticamente).
CTE_DIR=./cte_xml

# Pasta base do fluxo de EDI OCOREN (torre de controle de entregas). O botão
# "Escanear pasta" lê os arquivos de EDI_DIR/entrada e move os importados com
# sucesso para EDI_DIR/processados (arquivo com erro permanece na entrada).
EDI_DIR=./edi

# Arquivo JSON de mapeamento CNPJ -> transportadora usado pelo auditor
CARRIER_MAPPING_FILE=./tables/transportadoras_cnpj.json

# Tabela de-para dos códigos de ocorrência EDI (OCOREN) -> categoria interna.
# Edite para incluir códigos próprios das suas transportadoras.
OCOREN_CODIGOS_FILE=./tables/ocorrencias_codigos.json

# Limites de upload de CTe (proteção contra DoS por volume)
MAX_UPLOAD_FILES=200
MAX_FILE_SIZE_BYTES=5242880
